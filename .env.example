# Required for production launch-interest submissions.
#
# Recommended storage: Supabase. Create a free project at supabase.com, run
# supabase/schema.sql in the SQL editor, then copy the Project URL and the
# anon public key from Project Settings -> API here (or into your host's
# environment). The anon key is designed to be public in the browser; the
# schema keeps table access locked down and routes inserts through the
# create_launch_interest() function.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional alternative to Supabase: a backend endpoint that accepts POST JSON.
# Used only when VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY are not set.
VITE_LAUNCH_INTEREST_ENDPOINT=https://api.zama.bt/v1/launch-interests

# Required for production contact-form submissions. Copy these from the EmailJS
# dashboard (Account page / Email Services / Email Templates). The public key is
# safe to ship in the browser; service and template IDs are identifiers too.
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=

# Auto-reply confirmation sent straight back to the person who used the
# contact form. Create a second template whose "To Email" is {{reply_to}}.
VITE_EMAILJS_AUTOREPLY_TEMPLATE_ID=

# Server-side service role key (scripts only, never ship to the browser).
# Used by npm run db:seed and npm run db:add-admin via scripts/seed-content.ts
# and scripts/add-admin.mjs. It has full database access, so keep it only in
# .env.local or your host's environment — never in VITE_* variables.
SUPABASE_SERVICE_ROLE_KEY=
