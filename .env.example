# Required for production launch-interest submissions.
VITE_LAUNCH_INTEREST_ENDPOINT=https://api.zama.bt/v1/launch-interests

# Required for production contact-form submissions. Copy these from the EmailJS
# dashboard (Account page / Email Services / Email Templates). The public key is
# safe to ship in the browser; service and template IDs are identifiers too.
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=

# Auto-reply confirmation sent straight back to the person who used the
# contact form. Create a second template whose "To Email" is {{reply_to}}.
VITE_EMAILJS_AUTOREPLY_TEMPLATE_ID=
